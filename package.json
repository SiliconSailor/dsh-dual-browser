{
  "name": "dsh-dual-browser",
  "version": "0.1.1",
  "description": "Agent browser for DeepSeek Harness with two visibility modes: hidden sessions for private research and visible sessions you can watch, plus a left-sidebar panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "SiliconSailor",
    "url": "https://github.com/SiliconSailor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiliconSailor/dsh-dual-browser.git"
  },
  "homepage": "https://github.com/SiliconSailor/dsh-dual-browser#readme",
  "bugs": {
    "url": "https://github.com/SiliconSailor/dsh-dual-browser/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "playwright",
    "headless",
    "automation",
    "agent"
  ],
  "dependencies": {
    "playwright-core": "1.65.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
